#include <stdio.h>

long long fact(int n) {
    if(n == 0 || n == 1)
        return 1;
    return n * fact(n - 1);
}

int main() {
    int n;
    scanf("%d", &n);
    printf("%lld", fact(n));
    return 0;
}



#include <stdio.h>

int fib(int n) {
    if(n <= 1)
        return n;
    return fib(n - 1) + fib(n - 2);
}

int main() {
    int n;
    scanf("%d", &n);
    printf("%d", fib(n));
    return 0;
}






#include <stdio.h>

int sumDigits(int n) {
    if(n == 0)
        return 0;
    return n % 10 + sumDigits(n / 10);
}

int main() {
    int n;
    scanf("%d", &n);
    printf("%d", sumDigits(n));
    return 0;
}




#include <stdio.h>

int reverse(int n, int rev) {
    if(n == 0)
        return rev;
    return reverse(n / 10, rev * 10 + n % 10);
}

int main() {
    int n;
    scanf("%d", &n);
    printf("%d", reverse(n, 0));
    return 0;
}
