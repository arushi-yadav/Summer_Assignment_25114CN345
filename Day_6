#include <stdio.h>

int main() {
    int n, binary[32], i = 0;

    printf("Enter decimal number: ");
    scanf("%d", &n);

    while(n > 0) {
        binary[i] = n % 2;
        n /= 2;
        i++;
    }

    for(i = i - 1; i >= 0; i--)
        printf("%d", binary[i]);

    return 0;
}




#include <stdio.h>
#include <math.h>

int main() {
    long long bin;
    int rem, dec = 0, i = 0;

    printf("Enter binary number: ");
    scanf("%lld", &bin);

    while(bin > 0) {
        rem = bin % 10;
        dec += rem * pow(2, i);
        bin /= 10;
        i++;
    }

    printf("Decimal = %d", dec);

    return 0;
}





#include <stdio.h>

int main() {
    int n, count = 0;

    printf("Enter number: ");
    scanf("%d", &n);

    while(n > 0) {
        count += n & 1;
        n >>= 1;
    }

    printf("Set Bits = %d", count);

    return 0;
}




#include <stdio.h>

int main() {
    int x, n, i;
    long long result = 1;

    printf("Enter x and n: ");
    scanf("%d %d", &x, &n);

    for(i = 1; i <= n; i++)
        result *= x;

    printf("%lld", result);

    return 0;
}
