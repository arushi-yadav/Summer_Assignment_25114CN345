#include <stdio.h>

int main() {
    int n, i, sum = 0;

    printf("Enter number: ");
    scanf("%d", &n);

    for(i = 1; i < n; i++) {
        if(n % i == 0)
            sum += i;
    }

    if(sum == n)
        printf("Perfect Number");
    else
        printf("Not Perfect Number");

    return 0;
}





#include <stdio.h>

int main() {
    int n, temp, rem, sum = 0, i, fact;

    printf("Enter number: ");
    scanf("%d", &n);

    temp = n;

    while(temp > 0) {
        rem = temp % 10;
        fact = 1;

        for(i = 1; i <= rem; i++)
            fact *= i;

        sum += fact;
        temp /= 10;
    }

    if(sum == n)
        printf("Strong Number");
    else
        printf("Not Strong Number");

    return 0;
}




#include <stdio.h>

int main() {
    int n, i;

    printf("Enter number: ");
    scanf("%d", &n);

    for(i = 2; i <= n; i++) {
        while(n % i == 0) {
            printf("%d ", i);
            n /= i;
        }
    }

    return 0;
}





#include <stdio.h>

int main() {
    int n, largest = 0, i;

    printf("Enter number: ");
    scanf("%d", &n);

    for(i = 2; i <= n; i++) {
        while(n % i == 0) {
            largest = i;
            n /= i;
        }
    }

    printf("Largest Prime Factor = %d", largest);

    return 0;
}





